# PostgreSQL Message Store (the scraper's DB on Railway).
# The Digest Service is a read-only consumer — see docs/adr/0001-*.
DATABASE_URL=

# LLM — any OpenAI-compatible chat-completions endpoint (OpenRouter or similar).
# LLM_BASE_URL is the base up to /v1; the code appends /chat/completions.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4.6

# Optional fallback LLM provider (see docs/adr/0002-fallback-llm-provider.md).
# A failed request falls through to it instead of costing the day's digest.
# All three or none — a half-configured fallback fails config load.
# Keep the model NON-REASONING: reasoning tokens are billed against the same
# max_tokens budget as the answer, so a reasoning model trips both the 60 s
# timeout and the truncation guard on a busy day.
LLM_FALLBACK_BASE_URL=https://api.neuraldeep.ru/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=qwen3.6-unlim-noreason

# Telegram bot that posts the digest, and the destination channel/chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DIGEST_CHAT_ID=

# Optional chat for alerts: one short message goes here through the same bot
# when a run fails, and a differently worded one when the digest came out on
# the fallback provider. Leave empty and both are logged only — an
# unconfigured alert never turns a working deployment into a failing one.
# Must NOT be TELEGRAM_DIGEST_CHAT_ID: readers of the digest do not need
# internal plumbing, and anything posted to the channel is forwarded back into
# a Monitored Chat and would land in the next digest's input.
TELEGRAM_ALERT_CHAT_ID=
